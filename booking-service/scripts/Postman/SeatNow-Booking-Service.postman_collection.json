{
  "info": {
    "name": "SeatNow - Booking Service",
    "_postman_id": "booking-service-2026-v2",
    "description": "Complete API collection for SeatNow Booking Service with all endpoints and assertions.\nBase URL: http://localhost:3004\n\nSetup: Login via Auth collection to get {{token}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3004/api/v1", "type": "string" },
    { "key": "token", "value": "", "type": "string", "description": "Lay tu Auth - Login" },
    { "key": "restaurantId", "value": "BA3FB828-C52C-4FBE-83E7-4F326A9892A2", "type": "string" },
    { "key": "tableId", "value": "AA07C586-38BB-423A-8554-1FE87348D2C1", "type": "string" },
    { "key": "bookingId", "value": "", "type": "string" },
    { "key": "bookingCode", "value": "", "type": "string" },
    { "key": "guestPhone", "value": "+84901234567", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Public/Guest Operations",
      "item": [
        {
          "name": "Create Booking (Guest)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const res = pm.response.json();",
                  "const booking = res.data || res.booking || res;",
                  "pm.test('Booking created with code', function () {",
                  "    pm.expect(booking).to.have.property('id');",
                  "    pm.expect(booking).to.have.property('bookingCode');",
                  "});",
                  "",
                  "if (booking.id) {",
                  "    pm.collectionVariables.set('bookingId', booking.id);",
                  "    pm.collectionVariables.set('bookingCode', booking.bookingCode);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"restaurantId\": \"{{restaurantId}}\",\n  \"tableId\": \"{{tableId}}\",\n  \"bookingDate\": \"2026-12-25\",\n  \"bookingTime\": \"19:00\",\n  \"numGuests\": 4,\n  \"guestName\": \"Guest Test\",\n  \"guestPhone\": \"{{guestPhone}}\",\n  \"guestEmail\": \"guest@example.com\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/bookings"
          }
        },
        {
          "name": "Guest Lookup Booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const res = pm.response.json();",
                  "pm.test('Found correct booking', function () {",
                  "    pm.expect(res.bookingCode || res.data.bookingCode).to.eql(pm.collectionVariables.get('bookingCode'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/bookings/guest/lookup?bookingCode={{bookingCode}}&guestPhone={{guestPhone}}",
              "host": ["{{baseUrl}}"],
              "path": ["bookings", "guest", "lookup"],
              "query": [
                { "key": "bookingCode", "value": "{{bookingCode}}" },
                { "key": "guestPhone", "value": "{{guestPhone}}" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Customer Operations",
      "item": [
        {
          "name": "Create Booking (Customer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const res = pm.response.json();",
                  "const booking = res.data || res.booking || res;",
                  "if (booking.id) {",
                  "    pm.collectionVariables.set('bookingId', booking.id);",
                  "    pm.collectionVariables.set('bookingCode', booking.bookingCode);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"restaurantId\": \"{{restaurantId}}\",\n  \"tableId\": \"{{tableId}}\",\n  \"bookingDate\": \"2026-12-25\",\n  \"bookingTime\": \"20:00\",\n  \"numGuests\": 2\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/bookings"
          }
        },
        {
          "name": "Get My Bookings",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const res = pm.response.json();",
                  "pm.test('Response is array', function () {",
                  "    pm.expect(res.data || res).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/bookings/my-bookings"
          }
        },
        {
          "name": "Get Booking Detail",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/bookings/{{bookingId}}"
          }
        },
        {
          "name": "Get Booking QR",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Content-Type is image', function () {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.include('image');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/bookings/{{bookingId}}/qr"
          }
        },
        {
          "name": "Cancel Booking (Customer)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cancellationReason\": \"User cancelled test\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/bookings/{{bookingId}}/cancel"
          }
        }
      ]
    },
    {
