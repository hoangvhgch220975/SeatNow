								"value": "Bearer {{accessToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/bookings/{{bookingId}}/arrived",
							"host": ["{{baseUrl}}"],
							"path": ["bookings", "{{bookingId}}", "arrived"]
						},
						"description": "Mark a confirmed booking as arrived (Owner/Admin only)"
					},
					"response": []
				},
				{
					"name": "Complete Booking",
					"request": {
						"method": "PUT",
