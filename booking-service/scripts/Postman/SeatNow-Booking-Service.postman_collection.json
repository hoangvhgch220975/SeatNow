	"item": [
		{
			"name": "1. Public/Guest Operations",
			"item": [
				{
					"name": "Create Booking (Guest)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    const res = pm.response.json();",
									"    pm.collectionVariables.set('bookingId', res.data.id);",
									"    pm.collectionVariables.set('bookingCode', res.data.bookingCode);",
									"    console.log('Booking ID:', res.data.id);",
									"    console.log('Booking Code:', res.data.bookingCode);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"restaurantId\": \"{{restaurantId}}\",\n  \"tableId\": \"{{tableId4}}\",\n  \"bookingDate\": \"2026-02-15\",\n  \"bookingTime\": \"19:00\",\n  \"numGuests\": 4,\n  \"guestName\": \"Nguyen Van A\",\n  \"guestPhone\": \"+84901234567\",\n  \"guestEmail\": \"nguyenvana@example.com\",\n  \"specialRequests\": \"Gần cửa sổ, ưu tiên khu yên tĩnh\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/bookings",
							"host": ["{{baseUrl}}"],
							"path": ["bookings"]
						},
						"description": "Create a new booking as a guest (no authentication required)"
					},
					"response": []
				},
				{
					"name": "Create Booking (Customer)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    const res = pm.response.json();",
									"    const booking = res.booking || res.data?.booking || res.data;",
									"    if (booking) {",
									"        pm.collectionVariables.set('bookingId', booking.id);",
									"        pm.collectionVariables.set('bookingCode', booking.bookingCode);",
									"        console.log('✅ Booking Created');",
									"        console.log('Booking ID:', booking.id);",
									"        console.log('Booking Code:', booking.bookingCode);",
									"        console.log('Status:', booking.status);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"restaurantId\": \"{{restaurantId}}\",\n  \"tableId\": \"{{tableId}}\",\n  \"bookingDate\": \"2026-02-20\",\n  \"bookingTime\": \"20:00\",\n  \"numGuests\": 2,\n  \"specialRequests\": \"Kỷ niệm ngày cưới, nhờ chuẩn bị hoa và nến\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/bookings",
							"host": ["{{baseUrl}}"],
							"path": ["bookings"]
						},
						"description": "Create a new booking as an authenticated customer"
					},
					"response": []
				},
				{
					"name": "Guest Lookup Booking",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/bookings/guest/lookup?bookingCode={{bookingCode}}&guestPhone=%2B84901234567",
							"host": ["{{baseUrl}}"],
							"path": ["bookings", "guest", "lookup"],
							"query": [
								{
									"key": "bookingCode",
									"value": "{{bookingCode}}"
								},
								{
									"key": "guestPhone",
									"value": "+84901234567"
								}
							]
						},
						"description": "Lookup a booking using booking code and phone number (for guests)"
					},
					"response": []
				},
				{
					"name": "Check Availability",
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/restaurants/{{restaurantId}}/availability?date=2026-02-15&time=19:00&guests=4",
							"host": ["{{baseUrl}}"],
							"path": ["restaurants", "{{restaurantId}}", "availability"],
							"query": [
								{
									"key": "date",
									"value": "2026-02-15"
								},
								{
									"key": "time",
									"value": "19:00"
								},
								{
									"key": "guests",
									"value": "4",
									"description": "Number of guests"
								}
							]
						},
						"description": "Check available tables for a specific date, time, and number of guests"
					},
					"response": []
				}
			]
		},
		{
			"name": "2. Customer Operations",
			"item": [
				{
					"name": "My Bookings",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/bookings/my-bookings?status=PENDING&sortBy=bookingDate&sortOrder=DESC&page=1&limit=10",
							"host": ["{{baseUrl}}"],
							"path": ["bookings", "my-bookings"],
							"query": [
								{
									"key": "status",
									"value": "PENDING",
									"description": "PENDING, CONFIRMED, ARRIVED, COMPLETED, CANCELLED, NO_SHOW"
								},
								{
									"key": "sortBy",
									"value": "bookingDate"
								},
								{
									"key": "sortOrder",
									"value": "DESC"
								},
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "limit",
									"value": "10"
								}
							]
						},
						"description": "Get authenticated customer's bookings with filters"
					},
					"response": []
				},
				{
					"name": "Cancel Booking (Customer)",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"cancellationReason\": \"Thay đổi kế hoạch, không thể đến được\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/bookings/{{bookingId}}/cancel",
							"host": ["{{baseUrl}}"],
							"path": ["bookings", "{{bookingId}}", "cancel"]
						},
						"description": "Cancel a booking as an authenticated customer"
					},
					"response": []
				}
			]
		},
		{
			"name": "3. Restaurant Owner/Admin Operations",
			"item": [
				{
					"name": "Get Restaurant Bookings",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/restaurants/{{restaurantId}}/bookings?date=2026-02-15&status=PENDING&sortBy=bookingTime&sortOrder=ASC&page=1&limit=20",
							"host": ["{{baseUrl}}"],
							"path": ["restaurants", "{{restaurantId}}", "bookings"],
							"query": [
								{
									"key": "date",
									"value": "2026-02-15",
									"description": "Filter by booking date (YYYY-MM-DD)"
								},
								{
									"key": "status",
									"value": "PENDING",
									"description": "Filter by status"
								},
								{
									"key": "sortBy",
									"value": "bookingTime"
								},
								{
									"key": "sortOrder",
									"value": "ASC"
								},
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "limit",
									"value": "20"
								}
							]
						},
						"description": "Get all bookings for a restaurant (Owner/Admin only)"
					},
					"response": []
				},
				{
					"name": "Confirm Booking",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/bookings/{{bookingId}}/confirm",
							"host": ["{{baseUrl}}"],
							"path": ["bookings", "{{bookingId}}", "confirm"]
						},
						"description": "Confirm a pending booking (Owner/Admin only)"
					},
					"response": []
				},
				{
					"name": "Mark as Arrived",
					"request": {
						"method": "PUT",
						"header": [
