						"url": {
							"raw": "{{baseUrl}}/bookings/{{bookingId}}/complete",
							"host": ["{{baseUrl}}"],
							"path": ["bookings", "{{bookingId}}", "complete"]
						},
						"description": "Complete an arrived booking (Owner/Admin only)"
					},
					"response": []
				},
				{
					"name": "Mark as No-Show",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/bookings/{{bookingId}}/no-show",
							"host": ["{{baseUrl}}"],
							"path": ["bookings", "{{bookingId}}", "no-show"]
						},
						"description": "Mark a confirmed booking as no-show (Owner/Admin only)"
					},
					"response": []
				}
