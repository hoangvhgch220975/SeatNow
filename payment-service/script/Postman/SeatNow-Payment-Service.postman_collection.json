{
  "info": {
    "name": "SeatNow - Payment Service",
    "_postman_id": "payment-service-v2",
    "description": "Collection for Payment Service: Wallet, Deposits, Withdrawals.\nBase URL: http://localhost:3005\nSetup: Login via Auth to get {{token}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3005/api/v1/payment", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "walletId", "value": "", "type": "string" },
    { "key": "withdrawalId", "value": "", "type": "string" },
    { "key": "internalToken", "value": "vhTony_24_internal_token", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Wallet Operations",
      "item": [
        {
          "name": "Get My Wallet",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const res = pm.response.json();",
                  "pm.test('Wallet has balance', function () {",
                  "    pm.expect(res).to.have.property('balance');",
                  "});",
                  "if (res.id) pm.collectionVariables.set('walletId', res.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/wallet/me"
          }
        },
        {
          "name": "Get Wallet Transactions",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const res = pm.response.json();",
                  "pm.test('Response is array', function () {",
                  "    pm.expect(res.data || res).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/wallet/transactions"
          }
        }
      ]
    },
    {
      "name": "2. Withdrawals",
      "item": [
        {
          "name": "Request Withdrawal",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const res = pm.response.json();",
                  "if (res.id) pm.collectionVariables.set('withdrawalId', res.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 500000,\n  \"bankInfo\": \"Test Bank - 123456789\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/wallet/withdraw"
          }
        },
        {
          "name": "Internal Approve Withdrawal",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-internal-token", "value": "{{internalToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"adminId\": \"system-admin\",\n  \"note\": \"Approved for test\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/internal/wallet/withdraw/{{withdrawalId}}/approve"
          }
        }
      ]
    }
  ]
}
