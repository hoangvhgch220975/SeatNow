{
  "info": {
    "name": "SeatNow Restaurant Service",
    "_postman_id": "restaurant-service-collection",
    "description": "Collection to test restaurant-service endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3003"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "restaurantId",
      "value": "1"
    },
    {
      "key": "restaurantOwnerId",
      "value": "<owner-uuid>"
    },
    {
      "key": "itemId",
      "value": "1"
    },
    {
      "key": "tableId",
      "value": "1"
    },
    {
      "key": "availabilityDate",
      "value": "2026-03-20"
    },
    {
      "key": "availabilityTime",
      "value": "19:00"
    },
    {
      "key": "availabilityGuests",
      "value": "4"
    }
  ],
  "item": [
    {
      "name": "01. Health",
      "item": [
        {
          "name": "GET Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    },
    {
      "name": "02. Restaurants",
      "item": [
        {
          "name": "GET List Restaurants",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/restaurants?limit=10"
          }
        },
        {
          "name": "GET Restaurant Detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/restaurants/{{restaurantId}}"
          }
        },
        {
          "name": "POST Create Restaurant [ADMIN]",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ownerId\": \"{{restaurantOwnerId}}\",\n  \"name\": \"Nhà hàng Hoa Sen\",\n  \"address\": \"123 Đường Lê Lợi, Quận 1\",\n  \"latitude\": 10.77653,\n  \"longitude\": 106.70098,\n  \"phone\": \"+84900111222\",\n  \"email\": \"contact@hoasen.com\",\n  \"cuisineTypes\": [\"Vietnamese\"],\n  \"priceRange\": 2,\n  \"description\": \"Nhà hàng phục vụ phở và món Việt truyền thống.\",\n  \"images\": [\"https://example.com/hoasen.jpg\"],\n  \"openingHours\": {\"mon-fri\": \"10:00-22:00\", \"sat-sun\": \"08:00-23:00\"},\n  \"status\": \"active\",\n  \"commissionRate\": 0.1,\n  \"isPremium\": false,\n  \"depositEnabled\": false,\n  \"depositPolicy\": null\n}"
            },
            "url": "{{baseUrl}}/api/v1/restaurants"
          }
        },
        {
          "name": "PUT Update Restaurant [ADMIN|OWNER]",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Nhà hàng Hoa Sen - CN1\",\n  \"address\": \"125 Đường Lê Lợi\",\n  \"priceRange\": 3,\n  \"description\": \"Cập nhật thông tin cơ bản của nhà hàng\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/restaurants/{{restaurantId}}"
          }
        },
        {
          "name": "PUT Update Sensitive Fields [ADMIN]",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"active\",\n  \"commissionRate\": 0.12,\n  \"isPremium\": true\n}"
            },
            "url": "{{baseUrl}}/api/v1/restaurants/{{restaurantId}}"
          }
        },
        {
          "name": "PUT Update Deposit Policy [ADMIN|OWNER]",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"depositEnabled\": true,\n  \"depositPolicy\": {\n    \"amount\": 150000,\n    \"note\": \"Deposit on weekends\"\n  }\n}"
            },
            "url": "{{baseUrl}}/api/v1/restaurants/{{restaurantId}}/deposit-policy"
          }
        },
        {
          "name": "DELETE Restaurant [ADMIN|OWNER]",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/restaurants/{{restaurantId}}"
          }
        },
        {
          "name": "GET Revenue Statistics [ADMIN|OWNER]",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/restaurants/{{restaurantId}}/revenue-stats?period=month"
          }
        }
      ]
    },
    {
      "name": "03. Menu",
      "item": [
        {
          "name": "GET Menu",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/restaurants/{{restaurantId}}/menu"
          }
        },
        {
          "name": "POST Create Menu Item [ADMIN|OWNER]",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Phở Bò Đặc Biệt\",\n  \"description\": \"Phở bò tái, chín, gân\",\n  \"price\": 70000,\n  \"discountPrice\": 60000,\n  \"category\": \"Soup\",\n  \"images\": [\"https://example.com/images/pho.jpg\"],\n  \"isAvailable\": true,\n  \"tags\": [\"beef\", \"noodle\"],\n  \"allergens\": [\"gluten\"]\n}"
            },
            "url": "{{baseUrl}}/api/v1/restaurants/{{restaurantId}}/menu"
          }
        },
        {
          "name": "PUT Update Menu Item [ADMIN|OWNER]",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Phở Bò (lớn)\",\n  \"price\": 80000,\n  \"isAvailable\": true\n}"
            },
            "url": "{{baseUrl}}/api/v1/restaurants/{{restaurantId}}/menu/{{itemId}}"
          }
        },
        {
          "name": "DELETE Menu Item [ADMIN|OWNER]",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/restaurants/{{restaurantId}}/menu/{{itemId}}"
          }
        }
      ]
    },
    {
      "name": "04. Reviews",
      "item": [
        {
          "name": "GET Reviews",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/restaurants/{{restaurantId}}/reviews"
          }
        },
        {
          "name": "POST Create Review [CUSTOMER|ADMIN]",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookingId\": \"booking_1001\",\n  \"rating\": 5,\n  \"comment\": \"Đồ ăn ngon, phục vụ tốt\",\n  \"foodRating\": 5,\n  \"serviceRating\": 5,\n  \"atmosphereRating\": 4,\n  \"images\": []\n}"
            },
            "url": "{{baseUrl}}/api/v1/restaurants/{{restaurantId}}/reviews"
          }
        }
      ]
    },
    {
      "name": "05. Tables",
      "item": [
        {
          "name": "GET Tables [ADMIN|OWNER]",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/restaurants/{{restaurantId}}/tables"
          }
        },
        {
          "name": "POST Create Table [ADMIN|OWNER]",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tableNumber\": 1,\n  \"capacity\": 6,\n  \"type\": \"vip\",\n  \"location\": \"Trong phòng riêng\",\n  \"status\": \"active\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/restaurants/{{restaurantId}}/tables"
          }
        },
        {
          "name": "PUT Update Table [ADMIN|OWNER]",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tableNumber\": 1,\n  \"capacity\": 8,\n  \"status\": \"inactive\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/restaurants/{{restaurantId}}/tables/{{tableId}}"
          }
        },
        {
          "name": "DELETE Table [ADMIN|OWNER]",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/restaurants/{{restaurantId}}/tables/{{tableId}}"
          }
        }
      ]
    },
    {
      "name": "06. Availability",
      "item": [
        {
          "name": "GET Availability",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/restaurants/{{restaurantId}}/availability?date={{availabilityDate}}&time={{availabilityTime}}&guests={{availabilityGuests}}"
          }
        }
      ]
    }
  ]
}