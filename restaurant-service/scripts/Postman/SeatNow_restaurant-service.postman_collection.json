{
  "info": {
    "name": "SeatNow Restaurant Service",
    "_postman_id": "restaurant-service-collection",
    "description": "Collection to test restaurant-service endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3003" },
    { "key": "token", "value": "" },
    { "key": "restaurantId", "value": "1" },
    { "key": "itemId", "value": "1" },
    { "key": "tableId", "value": "1" },
    { "key": "availabilityDate", "value": "2026-03-20" },
    { "key": "availabilityTime", "value": "19:00" },
    { "key": "availabilityGuests", "value": "4" }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "List Restaurants",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/restaurants?limit=2"
      }
    },
    {
      "name": "Get Restaurant (by id)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/restaurants/{{restaurantId}}"
      }
    },
    {
      "name": "Get Menu",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/restaurants/{{restaurantId}}/menu"
      }
    },
    {
      "name": "Create Menu Item",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Phở Bò Đặc Biệt\",\n  \"description\": \"Phở bò tái, chín, gân\",\n  \"price\": 70000,\n  \"discountPrice\": 60000,\n  \"category\": \"Soup\",\n  \"images\": [\"https://example.com/images/pho.jpg\"],\n  \"isAvailable\": true,\n  \"tags\": [\"beef\", \"noodle\"],\n  \"allergens\": [\"gluten\"]\n}"
        },
        "url": "{{baseUrl}}/api/v1/restaurants/{{restaurantId}}/menu"
      }
    },
    {
      "name": "Update Menu Item",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Phở Bò (lớn)\",\n  \"price\": 80000,\n  \"isAvailable\": true\n}" },
        "url": "{{baseUrl}}/api/v1/restaurants/{{restaurantId}}/menu/{{itemId}}"
      }
    },
    {
      "name": "Delete Menu Item",
      "request": {
        "method": "DELETE",
        "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "url": "{{baseUrl}}/api/v1/restaurants/{{restaurantId}}/menu/{{itemId}}"
      }
    },
    {
      "name": "List Reviews",
      "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/v1/restaurants/{{restaurantId}}/reviews" }
    },
    {
      "name": "Create Review",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"bookingId\": \"booking_1001\",\n  \"rating\": 5,\n  \"comment\": \"Đồ ăn ngon, phục vụ tốt\",\n  \"foodRating\": 5,\n  \"serviceRating\": 5,\n  \"atmosphereRating\": 4,\n  \"images\": []\n}" },
        "url": "{{baseUrl}}/api/v1/restaurants/{{restaurantId}}/reviews"
      }
    },
    {
      "name": "List Tables",
      "request": {
        "method": "GET",
        "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "url": "{{baseUrl}}/api/v1/restaurants/{{restaurantId}}/tables"
      }
    },
    {
      "name": "Create Table",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"tableNumber\": 1,\n  \"capacity\": 6,\n  \"type\": \"vip\",\n  \"location\": \"Trong phòng riêng\",\n  \"status\": \"active\"\n}" },
        "url": "{{baseUrl}}/api/v1/restaurants/{{restaurantId}}/tables"
      }
    },
    {
      "name": "Update Table",
      "request": {
        "method": "PUT",
        "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "body": { "mode": "raw", "raw": "{\n  \"tableNumber\": 1,\n  \"capacity\": 8,\n  \"status\": \"inactive\"\n}" },
        "url": "{{baseUrl}}/api/v1/restaurants/{{restaurantId}}/tables/{{tableId}}"
      }
    },
    {
      "name": "Delete Table",
      "request": { "method": "DELETE", "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ], "url": "{{baseUrl}}/api/v1/restaurants/{{restaurantId}}/tables/{{tableId}}" }
    },
    {
      "name": "Create Restaurant",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Nhà hàng Hoa Sen\",\n  \"address\": \"123 Đường Lê Lợi, Quận 1\",\n  \"latitude\": 10.77653,\n  \"longitude\": 106.70098,\n  \"phone\": \"+84900111222\",\n  \"email\": \"contact@hoasen.example\",\n  \"cuisineTypes\": [\"Vietnamese\"],\n  \"priceRange\": 2,\n  \"description\": \"Nhà hàng phục vụ phở và món Việt truyền thống.\",\n  \"images\": [\"https://example.com/hoasen.jpg\"],\n  \"openingHours\": {\"mon-fri\": \"10:00-22:00\", \"sat-sun\": \"08:00-23:00\"}\n}" },
        "url": "{{baseUrl}}/api/v1/restaurants"
      }
    },
    {
      "name": "Update Restaurant",
      "request": {
        "method": "PUT",
        "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "body": { "mode": "raw", "raw": "{\n  \"name\": \"Nhà hàng Hoa Sen - CN1\",\n  \"address\": \"125 Đường Lê Lợi\",\n  \"priceRange\": 3\n}" },
        "url": "{{baseUrl}}/api/v1/restaurants/{{restaurantId}}"
      }
    },
    {
      "name": "Update Deposit Policy",
      "request": {
        "method": "PUT",
        "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "body": { "mode": "raw", "raw": "{\n  \"depositEnabled\": true,\n  \"depositPolicy\": { \"amount\": 150000, \"note\": \"Deposit on weekends\" }\n}" },
        "url": "{{baseUrl}}/api/v1/restaurants/{{restaurantId}}/deposit-policy"
      }
    },
    {
      "name": "Delete Restaurant",
      "request": { "method": "DELETE", "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ], "url": "{{baseUrl}}/api/v1/restaurants/{{restaurantId}}" }
    },
    {
      "name": "Availability (via booking-service)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/restaurants/{{restaurantId}}/availability?date={{availabilityDate}}&time={{availabilityTime}}&guests={{availabilityGuests}}"
      }
    }
  ]
}
