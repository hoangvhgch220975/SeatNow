# Server
PORT=3001

# SQL Server (LocalDB)
DB_USER=
DB_PASSWORD=
DB_SERVER=(localdb)\MSSQLLocalDB
DB_PORT=1433
DB_NAME=SeatNow
DB_ENCRYPT=true
DB_TRUST_CERT=true

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=vhTony_24_access
JWT_REFRESH_SECRET=vhTony_24_refresh
JWT_ACCESS_EXPIRES_IN=120m
JWT_REFRESH_EXPIRES_IN=7d

# Optional: Google/Firebase
# Recommended: point to a service account JSON file
# Option A (service account file):
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-sa.json
# Option B (full JSON in env):
# FIREBASE_CREDENTIALS_JSON='{"type":"service_account", ... }'
# Option C (individual fields - legacy):
# FIREBASE_PROJECT_ID=seatnow-43be0
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@seatnow-43be0.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
