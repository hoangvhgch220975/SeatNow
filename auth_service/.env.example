# Local environment for auth_service (created by assistant)
PORT=3001

# SQL Server (LocalDB) - parsed from your connection string
# Original: Data Source=(localdb)\MSSQLLocalDB;Integrated Security=True;Persist Security Info=False;Pooling=False;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=True;Application Name="SQL Server Management Studio";Command Timeout=30
# Use Windows Integrated Security (LocalDB) -> leave DB_USER/DB_PASSWORD empty
DB_USER=
DB_PASSWORD=
# For LocalDB use the instance name in DB_SERVER: (localdb)\MSSQLLocalDB
DB_SERVER=(localdb)\MSSQLLocalDB
DB_PORT=1433
DB_NAME=SeatNow
DB_PIPE_NAME=np:\\.\pipe\LOCALDB#050D5C32\tsql\query
DB_ENCRYPT=true
DB_TRUST_CERT=true

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=vhTony_24_access
JWT_REFRESH_SECRET=vhTony_24_refresh
JWT_ACCESS_EXPIRES_IN=120m
JWT_REFRESH_EXPIRES_IN=7d

# Firebase service account (local)
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-sa.json
