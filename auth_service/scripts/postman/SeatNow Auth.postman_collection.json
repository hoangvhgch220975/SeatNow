    {
      "name": "1. OTP Flow",
      "item": [
        {
          "name": "Send OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const res = pm.response.json();",
                  "pm.test('Response has success field', function () {",
                  "    pm.expect(res).to.have.property('success');",
                  "    pm.expect(res.success).to.eql(true);",
                  "});",
                  "",
                  "pm.test('Response has message', function () {",
                  "    pm.expect(res).to.have.property('message');",
                  "    pm.expect(res.message).to.be.a('string');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{phone}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/send-otp",
              "host": ["{{baseUrl}}"],
              "path": ["send-otp"]
            },
            "description": "Gui OTP den so dien thoai. OTP duoc luu tren Redis."
          },
          "response": []
