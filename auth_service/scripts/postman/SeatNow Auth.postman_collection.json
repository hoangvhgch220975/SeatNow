    {
      "name": "6. Internal APIs (Admin only)",
      "item": [
        {
          "name": "Create Restaurant Owner",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const res = pm.response.json();",
                  "pm.test('Owner created with id', function () {",
                  "    pm.expect(res).to.have.property('user');",
                  "    pm.expect(res.user).to.have.property('id');",
                  "    pm.expect(res.user.role).to.eql('RESTAURANT_OWNER');",
                  "});",
                  "",
                  "if (res.user && res.user.id) {",
                  "    pm.collectionVariables.set('ownerId', res.user.id);",
                  "    console.log('Owner ID saved:', res.user.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-internal-token", "value": "{{internalToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"+84900000001\",\n  \"email\": \"owner_test@example.com\",\n  \"name\": \"Restaurant Owner Test\",\n  \"password\": \"OwnerPass123!\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/internal/users/restaurant-owner",
              "host": ["{{baseUrl}}"],
              "path": ["internal", "users", "restaurant-owner"]
            },
            "description": "Internal API: Tao tai khoan RESTAURANT_OWNER. Goi tu admin-service. Can x-internal-token."
          },
          "response": []
        },
